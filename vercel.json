{
  "installCommand": "npm install --ignore-scripts && npm install --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/ignore-zones", "destination": "/api/ignoreZones" },
    { "source": "/api/ignore-zones/:path*", "destination": "/api/ignoreZones" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/images/:type/:name", "destination": "/api/files?type=:type&name=:name" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
