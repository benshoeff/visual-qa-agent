{
  "name": "visual-qa-agent",
  "version": "1.0.0",
  "description": "Visual Regression Testing Agent",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "baseline": "tsx src/agent.ts --mode=baseline",
    "test": "tsx src/agent.ts --mode=test",
    "crawl": "tsx scripts/crawl.ts",
    "run:scheduled": "node scripts/run-scheduled.mjs",
    "server": "tsx src/server.ts",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --prefix client"
  },
  "dependencies": {
    "@lhci/cli": "^0.15.1",
    "@prisma/client": "^5.22.0",
    "@types/axe-core": "^2.0.2",
    "@types/uuid": "^10.0.0",
    "axe-core": "^4.12.1",
    "axe-playwright": "^2.2.2",
    "bullmq": "^5.80.0",
    "cors": "^2.8.6",
    "express": "^4.21.0",
    "ioredis": "^5.11.1",
    "lighthouse": "^12.8.2",
    "node-cron": "^4.4.1",
    "ollama": "^0.5.18",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.44.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.11.0",
    "uuid": "^14.0.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.4",
    "@vercel/node": "^3.2.1",
    "concurrently": "^9.2.3",
    "prisma": "^5.22.0",
    "typescript": "^5.4.0"
  }
}
