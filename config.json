{
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "threshold": 0.2,
  "waitFor": "networkidle",
  "pages": [
    {
      "name": "Homepage",
      "url": "https://qa-sandbox-app.vercel.app/",
      "threshold": 0.2
    },
    {
      "name": "Users",
      "url": "https://qa-sandbox-app.vercel.app/users"
    },
    {
